<launch>
  <!-- Launch file for hilti challenge LiDAR -->

    <arg name="rviz" default="true" />

    <rosparam command="load" file="$(find fast_lio)/config/xiangyin.yaml" />

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

    <!-- "-d 2" to wait for subscribers to connect, "-r 5" to play messages as fast as possbible -->
    <node pkg="rosbag" type="play" name="play" args="-d 2 -r 5 $(arg bag_filename)" />

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
    </group>

</launch>