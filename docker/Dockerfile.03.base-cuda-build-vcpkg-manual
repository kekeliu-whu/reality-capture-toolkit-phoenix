# Stage 1: Builder
FROM registry.cn-hangzhou.aliyuncs.com/c137/reality-capture-toolkit:base-cuda AS builder

# install packages
RUN apt-get update \
    && apt-get install -q -y libtool python3-jinja2 flex bison libxtst-dev autoconf automake autoconf-archive \
       unzip zip '^libxcb.*-dev' libx11-xcb-dev libgl1-mesa-dev libxrender-dev libxi-dev  libxkbcommon-dev libxkbcommon-x11-dev gfortran \
       libxi-dev libgl1-mesa-dev libglu1-mesa-dev mesa-common-dev libxrandr-dev libxxf86vm-dev \
       pkg-config python3.12-venv libxcursor-dev libxdamage-dev libxinerama-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir /buildspace && cd /buildspace \
    && git clone -b develop https://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@github.com/kekeliu-whu/vcpkg.git \
    && cd /buildspace/vcpkg \
    && ./bootstrap-vcpkg.sh

RUN for i in $(seq 1 20); do \
    /buildspace/vcpkg/vcpkg install boost pcl colmap[cuda] ceres[cuda] opencv cgal pdal rapidjson gtest mimalloc[override] crashpad yaml-cpp tinyxml --recurse && break || { \
      echo "Attempt $i failed. Retrying in 10 seconds..."; sleep 10; }; \
  done; \
  if [ $i -eq 20 ]; then echo "Installation failed after 20 attempts." && exit 1; fi; \
  rm -rf /buildspace/vcpkg/downloads /buildspace/vcpkg/buildtrees /buildspace/vcpkg/packages /var/lib/apt/lists/* /root/.cache/vcpkg


# Stage 2: Final Runtime Image
FROM registry.cn-hangzhou.aliyuncs.com/c137/reality-capture-toolkit:base-cuda

COPY --from=builder /buildspace/vcpkg /buildspace/vcpkg

CMD ["bash"]
